# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNTS_ENABLED=false
NEXT_PUBLIC_SHOP_ENABLED=false

# Legal identity. These values are rendered into the public legal pages.
# Do not enable analytics, customer accounts or commerce until the relevant fields are complete.
LEGAL_CONTROLLER_NAME=
LEGAL_TRADING_NAME=UNSAID
LEGAL_CONTACT_EMAIL=
LEGAL_REGISTERED_ADDRESS=
LEGAL_COUNTRY=Italia
LEGAL_VAT_NUMBER=
LEGAL_FISCAL_CODE=
LEGAL_REA=
LEGAL_PEC=
LEGAL_DPO_EMAIL=
LEGAL_COMMERCE_READY=false

# Catalog data source: keep "local" until Firebase Admin credentials are configured.
CATALOG_SOURCE=local

# Firebase Admin SDK (server-only; never expose these with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=unsaid-54c7e
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional explicit bootstrap owner for server-side admin APIs.
# Keep aligned with the bootstrap owner in firestore.rules until that rule is migrated.
ADMIN_OWNER_UID=

# Firebase Web SDK. These values identify the public web app; they are not server secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBANjiBKnAjUUmj7YQYTQ8AT2hpeWL-haM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=unsaid-54c7e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=unsaid-54c7e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=unsaid-54c7e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=246645030452
NEXT_PUBLIC_FIREBASE_APP_ID=1:246645030452:web:dca7295a518e84cac49461
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-DBJFXTJRR1

# Checkout preparation. Keep false until shipping/VAT values are reviewed and reservation cleanup is scheduled.
CHECKOUT_PREPAYMENT_ENABLED=false
COMMERCE_STANDARD_SHIPPING_CENTS=
# Optional. Leave blank when there is no free-shipping threshold.
COMMERCE_FREE_SHIPPING_THRESHOLD_CENTS=
# VAT rate in basis points, e.g. 2200 means 22%. Configure only after tax review.
COMMERCE_VAT_RATE_BPS=
COMMERCE_RESERVATION_MINUTES=15
# Set true only after /api/internal/checkout-expirations is scheduled and tested.
COMMERCE_RESERVATION_SWEEPER_READY=false
# Secret used by the external scheduler/Vercel Cron Authorization header.
CRON_SECRET=

# Stripe hosted Checkout. Keep false until test-mode checkout + signed webhook are configured and tested.
STRIPE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SESSION_MINUTES=30
# Optional pinned API-version override. Leave blank to use the version pinned in server code.
STRIPE_API_VERSION=

# Optional observability/auth
AUTH_SECRET=
SENTRY_DSN=
