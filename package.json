{
  "name": "unsaid",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @unsaid/web dev",
    "build": "pnpm --filter @unsaid/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "tsx --test packages/domain/test/*.test.ts apps/web/test/*.test.ts apps/worker/test/*.test.ts",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "seed:firestore:check": "pnpm --filter @unsaid/db seed:catalog",
    "seed:firestore": "pnpm --filter @unsaid/db seed:catalog -- --write",
    "media:validate": "pnpm --filter @unsaid/worker media:validate",
    "media:stage-masters": "pnpm --filter @unsaid/worker media:stage-masters",
    "media:ingest-masters": "pnpm --filter @unsaid/db media:ingest-masters",
    "media:attach-manifests": "pnpm --filter @unsaid/db media:attach-manifests",
    "media:publish-manifests": "pnpm --filter @unsaid/db media:publish-manifests",
    "media:render-products": "pnpm --filter @unsaid/worker media:render-products",
    "media:preview-products": "pnpm --filter @unsaid/worker media:preview-products"
  },
  "devDependencies": {
    "tsx": "catalog:"
  }
}
