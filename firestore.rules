rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap owner. Additional admins live in /admins/{uid}.
    function isOwner() {
      return signedIn() && request.auth.uid == "bFMrDg5iAOcWQ9VZwCuBHDrS1nB3";
    }

    function isAdmin() {
      return isOwner() || (
        signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /catalog/{recordId} {
      allow read, write: if isAdmin();
    }

    // Public storefront delivery happens server-side through Firebase Admin.
    // Browser reads stay closed so anonymous traffic cannot consume Firestore quota.
    match /publicCatalog/{recordId} {
      allow read, write: if isAdmin();
    }

    match /slugs/{slug} {
      allow read, write: if isAdmin();
    }

    match /meta/{documentId} {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // Customer profile, address and order access is intentionally mediated by
    // verified HttpOnly server sessions. A Firebase user alone is not enough to
    // access these documents directly from the browser SDK.
    match /customers/{uid} {
      allow read, write: if false;
      match /addresses/{addressId} {
        allow read, write: if false;
      }
    }

    // Commerce/payment/return state is authoritative server data. Client-side state never
    // grants write access to price, SKU, inventory, reservations, payments, returns or orders.
    match /sellableProducts/{id} { allow read, write: if false; }
    match /variants/{id} { allow read, write: if false; }
    match /inventory/{id} { allow read, write: if false; }
    match /inventoryReservations/{id} { allow read, write: if false; }
    match /checkoutAttempts/{id} { allow read, write: if false; }
    match /paymentSessionIntents/{id} { allow read, write: if false; }
    match /webhookEvents/{id} { allow read, write: if false; }
    match /orders/{id} { allow read, write: if false; }
    match /payments/{id} { allow read, write: if false; }
    match /refundCases/{id} { allow read, write: if false; }
    match /returnCases/{id} { allow read, write: if false; }
    match /shipments/{id} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
