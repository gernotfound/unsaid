rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Generated catalog media is intentionally public and immutable at the
    // application layer. Browser/client writes are never allowed.
    match /generated/products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Source garment masters are production inputs, not public assets.
    match /masters/{allPaths=**} {
      allow read, write: if false;
    }

    // Fail closed for every other path until a dedicated policy is reviewed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
